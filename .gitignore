# Ignore everything by default; opt paths in explicitly below.
# Ignored (not repo material): jax/ (unmodified clone, build workspace),
# xla/ (its own git repo, branch "winjax"), tools/ (downloaded toolchains),
# .venv/, downloaded archives, logs.
/*

# Tracked top-level files
!/.gitignore
!/README.md
!/KNOWN_ISSUES.md
!/run_test_sweep.py

# Exported patch series for Bazel external repos
!/patches/

# Loader package source (jax_plugins/winjax_cuda)
!/winjax/

# Pip distribution sources/build scripts (winjax, winjax-cuda13-pjrt,
# winjax-cuda13-plugin); built wheels excluded via packaging/.gitignore
!/packaging/

# Hand-authored toolchain override repos
!/toolchains/
# ...except machine-generated / unpacked content:
/toolchains/cccl_patched/
/toolchains/cudnn/
# cuda_repos: keep only the Bazel repo definition files. The include/lib/bin/
# nvvm/... subdirs are machine-generated NTFS junctions into tools/ and must
# never be committed (git would recurse into them and add the CUDA SDK).
/toolchains/cuda_repos/*/*
!/toolchains/cuda_repos/*/BUILD
!/toolchains/cuda_repos/*/WORKSPACE
!/toolchains/cuda_repos/*/version.bzl

# Logs anywhere
*.log

hugging_face.txt
hf_token.txt
testpypi.txt

!examples/
!examples/**
