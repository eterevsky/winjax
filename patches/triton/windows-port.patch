diff --git a/BUILD b/BUILD
index 7263526..b7f6240 100644
--- a/BUILD
+++ b/BUILD
@@ -53,6 +53,24 @@ config_setting(
     },
 )
 
+config_setting(
+    name = "compiler_is_clang_cl",
+    flag_values = {
+        "@bazel_tools" +  # copybara:comment
+        "//tools/cpp:compiler": "clang-cl",
+    },
+)
+
+# clang-cl defaults to MSVC-style delayed template parsing, under which MLIR
+# template bodies (e.g. TypeID::get) are parsed at the end of the TU. TUs that
+# re-open `namespace mlir` with `using namespace triton;` then make several
+# `detail` namespaces visible inside `mlir`, so unqualified `detail::` lookups
+# in MLIR headers become ambiguous. Restore standard two-phase lookup.
+_no_delayed_template_parsing = select({
+    ":compiler_is_clang_cl": ["-fno-delayed-template-parsing"],
+    "//conditions:default": [],
+})
+
 # TODO(csigg): fix, enable error upstream, remove.
 _no_unused_variable = select({
     ":compiler_is_msvc": [],
@@ -574,7 +592,7 @@ cc_library(
             "-Wno-ctad-maybe-unsupported",
             "-Wno-implicit-fallthrough",
         ],
-    }),
+    }) + _no_delayed_template_parsing,
     includes = ["include"],
     deps = [
         ":Dump",
